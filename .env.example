# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# A Game Server Login Token for app id 730, from
# https://steamcommunity.com/dev/managegameservers
#
# Without one the server runs and is invisible: it never appears in the public
# list, which from a player's side looks exactly like a server that is down.
CS2_SERVER_STEAM_TOKEN=

# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
CS2_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- the server
CS2_SERVER_NAME=CS2 Dedicated Server
# Leave empty for a public server; set it to require a password to join.
CS2_SERVER_PASSWORD=
CS2_SERVER_MAX_PLAYERS=10

# competitive, casual, deathmatch, wingman, custom...
CS2_SERVER_GAME_ALIAS=competitive
# mg_active is the current active-duty pool.
CS2_SERVER_MAP_GROUP=mg_active
CS2_SERVER_START_MAP=de_dust2

# 0 disables bots. With a quota above zero, "fill" tops the server up to the
# quota and "normal" keeps exactly that many whoever else is playing.
CS2_SERVER_BOT_QUOTA=0
CS2_SERVER_BOT_QUOTA_MODE=fill
CS2_SERVER_BOT_DIFFICULTY=1

# ---------------------------------------------------------------- networking
# The game and query port. It is published on the host under the same number
# on purpose: Steam's list records the port the server BINDS, so publishing a
# different one outside hands players an address where a different server
# answers.
CS2_SERVER_PORT=27015

CS2_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# CS2_SERVER_IMAGE_VERSION=4.0.1@sha256:...
# CS2_SERVER_IMAGE_TAG=joedwards32/cs2:4.0.1
#
# 4g is measured: a populated server sits near 950 MB. The ceiling exists so a
# leak here cannot get some other container killed instead.
# CS2_SERVER_MEMORY_LIMIT=4g
# CS2_SERVER_CPU_LIMIT=2.0
# CS2_SERVER_MEMORY_RESERVATION=1g
# CS2_SERVER_CPU_RESERVATION=0.5
#
# First boot downloads roughly 60 GB through SteamCMD. Anything shorter marks
# the container unhealthy for the whole of it.
# CS2_SERVER_START_PERIOD=90m
#
# srcds writes state on the way out; ten seconds and a SIGKILL loses it.
# CS2_SERVER_STOP_GRACE_PERIOD=30s
#
# CS2_SERVER_LOG_MAX_SIZE=10m
# CS2_SERVER_LOG_MAX_FILE=3
